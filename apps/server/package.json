{
  "name": "express-starter-kit",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "docker:up": "docker compose up",
    "db:generate": "pnpm exec drizzle-kit generate --config=./src/configs/drizzle.config.ts",
    "db:migrate": "pnpm exec drizzle-kit migrate --config=./src/configs/drizzle.config.ts",
    "db:push": "pnpm exec drizzle-kit push --config=./src/configs/drizzle.config.ts",
    "db:pull": "pnpm exec drizzle-kit pull --config=./src/configs/drizzle.config.ts",
    "db:check": "pnpm exec drizzle-kit check --config=./src/configs/drizzle.config.ts",
    "db:up": "pnpm exec drizzle-kit up --config=./src/configs/drizzle.config.ts",
    "db:studio": "pnpm exec drizzle-kit studio --config=./src/configs/drizzle.config.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.2.0",
    "@scalar/express-api-reference": "^0.8.30",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.66.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "http-status-codes": "^2.3.0",
    "install": "^0.13.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-appwrite": "^17.2.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.3.1",
    "validator": "^13.15.26",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.4",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.16.0",
    "@types/validator": "^13.15.10",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "prettier-eslint": "^16.4.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
