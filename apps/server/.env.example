PORT=5000

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/postgres

REDIS_URL=redis://127.0.0.1:6379

ACCESS_SECRET_KEY= your_secret_key
ACCESS_EXPIRATION_DURATION= 2000
REFRESH_SECRET_KEY= your_secret_key,
REFRESH_EXPIRATION_DURATION= 3600

# NODEMAILER
NODEMAILER_SMTP_PASS=nodemailer_smtp_pass
NODEMAILER_SMTP_HOST=smtp-relay.brevo.com
NODEMAILER_SMTP_USER=smtp_user
NODEMAILER_SMTP_PORT=587
NODEMAILER_FROM_EMAIL=email

# TEXTBEE API_KEY
TEXTBEE_BASE_URL=textbee_base_url
TEXTBEE_API_KEY=api_key
TEXTBEE_DEVICE_ID=device_id

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=project_id
APPWRITE_API_KEY=api_key
APPWRITE_BUCKET_ID=bucket_id


