{
  "name": "ai-project",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "build": "tsc && tsup",
    "start:dev": "node --import=tsx --watch src/index.ts",
    "start:prod": "node dist/index.js",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm exec drizzle-kit migrate",
    "db:push": "pnpm exec drizzle-kit push",
    "db:pull": "pnpm exec drizzle-kit pull",
    "db:check": "pnpm exec drizzle-kit check",
    "db:up": "pnpm exec drizzle-kit up",
    "db:studio": "pnpm exec drizzle-kit studio --verbose",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@dakshp1234/langchain-google-genai": "^2.1.30",
    "@dakshp1234/langchain-textsplitters": "^1.0.2",
    "@google/generative-ai": "^0.24.1",
    "@langchain/classic": "^1.0.35",
    "@langchain/cohere": "^1.1.0",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/redis": "^1.1.3",
    "@node-rs/argon2": "^2.0.2",
    "@scalar/express-api-reference": "^0.9.20",
    "better-sse": "^0.16.1",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.24",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-error-toolkit": "^1.2.1",
    "express-rate-limit": "^8.5.2",
    "express-zod-safe": "^3.2.1",
    "helmet": "^8.2.0",
    "http-status-codes": "^2.3.0",
    "jose": "^6.2.3",
    "langchain": "^1.4.6",
    "mime-types": "^3.0.2",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3",
    "unstructured-client": "^0.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-beta.24",
    "eslint": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "prettier-eslint": "^16.4.2",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "dist",
    "format": [
      "esm",
      "cjs"
    ],
    "target": "es2020",
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "splitting": false,
    "skipNodeModulesBundle": true
  }
}
