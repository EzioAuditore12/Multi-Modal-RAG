{
  "name": "ai-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "build": "tsc && tsup",
    "start:dev": "node --import=tsx --watch src/index.ts",
    "start:prod": "node dist/index.js",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:migrate": "pnpm exec drizzle-kit migrate",
    "db:push": "pnpm exec drizzle-kit push",
    "db:pull": "pnpm exec drizzle-kit pull",
    "db:check": "pnpm exec drizzle-kit check",
    "db:up": "pnpm exec drizzle-kit up",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@google/genai": "^1.46.0",
    "@langchain/classic": "^1.0.25",
    "@langchain/core": "^1.1.36",
    "@langchain/google": "^0.1.8",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/langgraph": "^1.2.5",
    "@node-rs/argon2": "^2.0.2",
    "@scalar/express-api-reference": "^0.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-error-toolkit": "^1.2.1",
    "express-rate-limit": "^8.3.1",
    "express-zod-safe": "^3.2.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jose": "^6.2.2",
    "langchain": "^1.2.37",
    "langsmith": "^0.5.13",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.1"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "outDir": "dist",
    "format": [
      "esm",
      "cjs"
    ],
    "target": "es2020",
    "sourcemap": true,
    "clean": true,
    "dts": true,
    "splitting": false,
    "skipNodeModulesBundle": true
  },
  "packageManager": "pnpm@10.15.0"
}
